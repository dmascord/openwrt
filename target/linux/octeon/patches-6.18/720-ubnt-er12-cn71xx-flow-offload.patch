+#define CVM_FLOW_BUCKETS 1024
+
+struct cvm_flow_block {
+	struct net		*net;
+	struct list_head	ports;
+	struct list_head	flows;
+};
+
+struct cvm_flow_port {
+	struct list_head	node;
+	struct net_device	*dev;
+};
+
+struct cvm_flow {
+	struct hlist_node	node;
+	struct hlist_node	cookie_node;
+	struct list_head	owner_node;
+	struct cvm_flow_block	*block;
+	struct rcu_head		rcu;
+	unsigned long		cookie;
+	__be32			saddr;
+	__be32			daddr;
+	struct in6_addr		s6;
+	struct in6_addr		d6;
+	__be16			sport;
+	__be16			dport;
+	u8			proto;
+	u8			v6;
+	int			iifidx;
+	__be32			nsaddr;
+	__be32			ndaddr;
+	struct in6_addr		ns6;
+	struct in6_addr		nd6;
+	__be16			nsport;
+	__be16			ndport;
+	u8			h_source[ETH_ALEN];
+	u8			h_dest[ETH_ALEN];
+	u8			in_h_dest[ETH_ALEN];
+	struct net_device	*txdev;
+	u16			mtu;
+	u8			in_pppoe;
+	u8			out_pppoe;
+	u8			in_vlan;
+	u8			out_vlan;
+	__be16			in_sid;
+	__be16			out_sid;
+	__be16			in_vid;
+	__be16			out_vid;
+	atomic64_t		pkts;
+	atomic64_t		bytes;
+	atomic64_t		pkts_reported;
+	atomic64_t		bytes_reported;
+	u32			lastused;
+};
+
+static struct hlist_head cvm_flow_buckets[CVM_FLOW_BUCKETS];
+static struct hlist_head cvm_flow_cookies[CVM_FLOW_BUCKETS];
+static DEFINE_SPINLOCK(cvm_flow_lock);
+static LIST_HEAD(cvm_oct_block_cb_list);
+
+static u32 cvm_flow_hash(__be32 saddr, __be32 daddr, __be16 sport,
+			 __be16 dport, u8 proto, int iifidx)
+{
+	u32 ports = ((__force u32)sport << 16) | (__force u32)dport;
+	u32 mix = jhash_2words(proto, iifidx, 0);
+
+	return jhash_3words((__force u32)saddr, (__force u32)daddr, ports, mix);
+}
+
+static struct cvm_flow *cvm_flow_lookup(__be32 saddr, __be32 daddr,
+					__be16 sport, __be16 dport,
+					u8 proto, int iifidx)
+{
+	u32 hash = cvm_flow_hash(saddr, daddr, sport, dport, proto, iifidx);
+	struct cvm_flow *e;
+
+	hlist_for_each_entry_rcu(e, &cvm_flow_buckets[hash & (CVM_FLOW_BUCKETS - 1)],
+				 node) {
+		if (!e->v6 && e->saddr == saddr && e->daddr == daddr &&
+		    e->sport == sport && e->dport == dport &&
+		    e->proto == proto && e->iifidx == iifidx)
+			return e;
+	}
+	return NULL;
+}
+
+static bool cvm_flow_addr6_eq(const struct in6_addr *a, const struct in6_addr *b)
+{
+	return !memcmp(a, b, sizeof(*a));
+}
+
+static u32 cvm_flow_hash6(const struct in6_addr *saddr,
+			  const struct in6_addr *daddr, __be16 sport,
+			  __be16 dport, u8 proto, int iifidx)
+{
+	u32 words[8];
+	u32 ports = ((__force u32)sport << 16) | (__force u32)dport;
+	u32 mix = jhash_2words(proto, iifidx, ports);
+
+	memcpy(words, saddr, sizeof(*saddr));
+	memcpy(words + 4, daddr, sizeof(*daddr));
+	return jhash2(words, 8, mix);
+}
+
+static struct cvm_flow *cvm_flow_lookup6(const struct in6_addr *saddr,
+					 const struct in6_addr *daddr,
+					 __be16 sport, __be16 dport,
+					 u8 proto, int iifidx)
+{
+	u32 hash = cvm_flow_hash6(saddr, daddr, sport, dport, proto, iifidx);
+	struct cvm_flow *e;
+
+	hlist_for_each_entry_rcu(e, &cvm_flow_buckets[hash & (CVM_FLOW_BUCKETS - 1)],
+				 node) {
+		if (e->v6 && e->sport == sport && e->dport == dport &&
+		    e->proto == proto && e->iifidx == iifidx &&
+		    cvm_flow_addr6_eq(&e->s6, saddr) &&
+		    cvm_flow_addr6_eq(&e->d6, daddr))
+			return e;
+	}
+	return NULL;
+}
+
+static struct cvm_flow *cvm_flow_by_cookie(struct cvm_flow_block *block,
+					unsigned long cookie)
+{
+	u32 hash = hash_ptr((void *)cookie, 10);
+	struct cvm_flow *e;
+
+	hlist_for_each_entry(e, &cvm_flow_cookies[hash & (CVM_FLOW_BUCKETS - 1)],
+			     cookie_node) {
+		if (e->cookie == cookie && e->block == block)
+			return e;
+	}
+	return NULL;
+}
+
+static void cvm_flow_free_rcu(struct rcu_head *head)
+{
+	struct cvm_flow *e = container_of(head, struct cvm_flow, rcu);
+
+	dev_put(e->txdev);
+	kfree(e);
+}
+
+static void cvm_flow_delete(struct cvm_flow *e)
+{
+	hlist_del_rcu(&e->node);
+	hlist_del(&e->cookie_node);
+	list_del(&e->owner_node);
+	call_rcu(&e->rcu, cvm_flow_free_rcu);
+}
+
+static void cvm_flow_flush(struct cvm_flow_block *block)
+{
+	struct cvm_flow *e, *next;
+
+	spin_lock_bh(&cvm_flow_lock);
+	list_for_each_entry_safe(e, next, &block->flows, owner_node)
+		cvm_flow_delete(e);
+	spin_unlock_bh(&cvm_flow_lock);
+}
+
+/* The flowtable's flow_block_lock protects the bound-port list. */
+static struct cvm_flow_port *cvm_flow_port_find(struct cvm_flow_block *block,
+					      struct net_device *dev)
+{
+	struct cvm_flow_port *port;
+
+	list_for_each_entry(port, &block->ports, node) {
+		if (port->dev == dev)
+			return port;
+	}
+	return NULL;
+}
+
+/*
+ * Is this physical port reached through one of the bound devices?
+ *
+ * On the CN50xx boards the bound device is the Octeon port itself. On
+ * the ER-12 it is the "itf" bond, and the port that actually sends the
+ * frame is one of its slaves. The flow's reverse direction resolves to
+ * such a slave, so the bound check has to look through the bond.
+ */
+static bool cvm_flow_port_bound(struct cvm_flow_block *block,
+				struct net_device *dev)
+{
+	struct cvm_flow_port *port;
+
+	list_for_each_entry(port, &block->ports, node) {
+		struct net_device *lower;
+		struct list_head *iter;
+
+		if (port->dev == dev)
+			return true;
+		if (!netif_is_bond_master(port->dev))
+			continue;
+		iter = &port->dev->adj_list.lower;
+		while ((lower = netdev_next_lower_dev_rcu(port->dev, &iter))) {
+			if (lower == dev)
+				return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * br_fdb_find_port() wants the rtnl lock, and this runs from the flow
+ * offload work while that lock cannot be taken. The caller holds
+ * rcu_read_lock(), so the bridge ports are walked with
+ * netdev_next_lower_dev_rcu(). That is the same lower list as
+ * netdev_for_each_lower_dev(), whose caller must hold rtnl.
+ *
+ * One Octeon port that is up and has a carrier is the USG case (one
+ * cable in a LAN port). A non-Octeon lower device that is up, or a
+ * second Octeon port with a carrier, stays on the normal path. Linux
+ * then forwards the neighbour behind that other port.
+ */
+static bool cvm_flow_octeon_dev(const struct net_device *dev)
+{
+	return dev->netdev_ops && dev->netdev_ops->ndo_start_xmit == cvm_oct_xmit;
+}
+
+static struct net_device *cvm_flow_physical(struct net_device *outdev)
+{
+	/* Never bypass a bond or bridge's normal egress selection. */
+	if (!outdev || netif_is_bond_master(outdev) ||
+	    netif_is_bridge_master(outdev))
+		return NULL;
+	if (cvm_flow_octeon_dev(outdev))
+		return outdev;
+	return NULL;
+}
+
+/* Caller holds RCU, just as the flowtable forward-path builder does. */
+static int cvm_flow_pppoe_mac(struct net_device *outdev, const u8 *h_dest,
+			      u8 *h_source)
+{
+	struct net_device_path_stack stack;
+	struct net_device_path_ctx ctx = {
+		.dev = outdev,
+	};
+	const struct net_device *dev;
+	int i;
+
+	ether_addr_copy(ctx.daddr, h_dest);
+	if (dev_fill_forward_path(&ctx, &stack) < 0)
+		return -ENODEV;
+
+	for (i = 0; i + 1 < stack.num_paths; i++) {
+		if (stack.path[i].type != DEV_PATH_PPPOE)
+			continue;
+		/*
+		 * __pppoe_xmit builds its Ethernet header on the session's
+		 * lower device, which may be a VLAN with its own MAC.
+		 * The PPP device's address is not an Ethernet address.
+		 */
+		dev = stack.path[i + 1].dev;
+		if (dev->addr_len != ETH_ALEN ||
+		    !is_valid_ether_addr(dev->dev_addr))
+			return -EOPNOTSUPP;
+		ether_addr_copy(h_source, dev->dev_addr);
+		return 0;
+	}
+	return -EOPNOTSUPP;
+}
+
+static int cvm_flow_l2(struct net *net, const struct flow_offload *flow,
+		       const struct flow_offload_tuple *tuple,
+		       bool pppoe,
+		       u8 h_source[ETH_ALEN], u8 h_dest[ETH_ALEN],
+		       struct net_device **txdev)
+{
+	const struct flow_offload_tuple *other;
+	struct net_device *outdev = NULL;
+	struct neighbour *neigh = NULL;
+	struct dst_entry *dst;
+	struct rtable *rt;
+	__be32 nexthop;
+	int ret = -ENOENT;
+
+	other = &flow->tuplehash[!tuple->dir].tuple;
+
+	if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT) {
+		outdev = dev_get_by_index(net, tuple->out.ifidx);
+		if (!outdev)
+			return -ENODEV;
+		ether_addr_copy(h_source, tuple->out.h_source);
+		ether_addr_copy(h_dest, tuple->out.h_dest);
+	} else if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_NEIGH) {
+		if (tuple->l3proto != NFPROTO_IPV4)
+			return -EOPNOTSUPP;
+		dst = tuple->dst_cache;
+		if (!dst || !dst->dev)
+			return -ENOENT;
+		rt = dst_rtable(dst);
+		nexthop = rt_nexthop(rt, other->src_v4.s_addr);
+		neigh = dst_neigh_lookup(dst, &nexthop);
+		if (!neigh || !(neigh->nud_state & NUD_VALID) ||
+		    is_zero_ether_addr(neigh->ha)) {
+			ret = -ENOENT;
+			goto out_neigh;
+		}
+		outdev = dst->dev;
+		dev_hold(outdev);
+		ether_addr_copy(h_dest, neigh->ha);
+		ether_addr_copy(h_source, outdev->dev_addr);
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	rcu_read_lock();
+	if (pppoe) {
+		ret = cvm_flow_pppoe_mac(outdev, h_dest, h_source);
+		if (ret) {
+			rcu_read_unlock();
+			goto out_dev;
+		}
+	}
+	*txdev = cvm_flow_physical(outdev);
+	/*
+	 * VLAN and PPPoE egress are those netdevs. The tuple also names the
+	 * ethernet port underneath (hw_ifidx). Send on that port.
+	 */
+	if (!*txdev && tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
+	    tuple->out.hw_ifidx &&
+	    tuple->out.hw_ifidx != tuple->out.ifidx) {
+		struct net_device *hwdev;
+
+		hwdev = dev_get_by_index_rcu(net, tuple->out.hw_ifidx);
+		*txdev = cvm_flow_physical(hwdev);
+	}
+	if (*txdev)
+		dev_hold(*txdev);
+	rcu_read_unlock();
+	if (!*txdev) {
+		ret = -ENODEV;
+		goto out_dev;
+	}
+	ret = 0;
+
+out_dev:
+	dev_put(outdev);
+out_neigh:
+	if (neigh)
+		neigh_release(neigh);
+	return ret;
+}
+
+/*
+ * Ingress of this direction, or egress (the other direction's ingress).
+ * encap[0] is the header next to Ethernet. A VLAN tag is outer. A PPPoE
+ * session header is inner. QinQ and a bridge VLAN tag stay on the normal
+ * path: this hardware does not strip or insert those itself.
+ */
+struct cvm_encap {
+	u8 pppoe;
+	u8 vlan;
+	__be16 sid;
+	__be16 vid;
+};
+
+static u16 cvm_tuple_encap_proto(const struct flow_offload_tuple *tuple, int i)
+{
+	if (i >= tuple->encap_num)
+		return 0;
+	return ntohs(tuple->encap[i].proto);
+}
+
+static int cvm_encap_from_tuple(const struct flow_offload_tuple *tuple,
+				struct cvm_encap *encap)
+{
+	unsigned int i;
+
+	encap->pppoe = 0;
+	encap->vlan = 0;
+	encap->sid = 0;
+	encap->vid = 0;
+
+	if (tuple->in_vlan_ingress || tuple->encap_num > 2)
+		return -EOPNOTSUPP;
+	if (!tuple->encap_num)
+		return 0;
+
+	for (i = 0; i < tuple->encap_num; i++) {
+		__be16 proto = tuple->encap[i].proto;
+		u16 id = tuple->encap[i].id;
+
+		if (proto == htons(ETH_P_8021Q)) {
+			/* The tag is the outer header. A second one is QinQ. */
+			if (encap->vlan || encap->pppoe || i != 0)
+				return -EOPNOTSUPP;
+			if (!id || id >= VLAN_VID_MASK)
+				return -EOPNOTSUPP;
+			encap->vlan = 1;
+			encap->vid = htons(id);
+		} else if (proto == htons(ETH_P_PPP_SES)) {
+			if (encap->pppoe || !id)
+				return -EOPNOTSUPP;
+			/* Alone, or just inside the one VLAN tag. */
+			if (i != encap->vlan)
+				return -EOPNOTSUPP;
+			encap->pppoe = 1;
+			encap->sid = htons(id);
+		} else {
+			return -EOPNOTSUPP;
+		}
+	}
+	return 0;
+}
+
+static int cvm_flow_replace(struct cvm_flow_block *block,
+			    struct flow_cls_offload *cls)
+{
+	const struct flow_offload_tuple *tuple, *other;
+	struct flow_offload_tuple_rhash *th;
+	struct net_device *txdev = NULL;
+	struct net_device *rxdev = NULL;
+	struct flow_offload *flow;
+	struct cvm_encap in_encap, out_encap;
+	struct cvm_flow *e;
+	u8 h_source[ETH_ALEN];
+	u8 h_dest[ETH_ALEN];
+	u8 in_h_dest[ETH_ALEN], in_h_source[ETH_ALEN];
+	u32 hash;
+	bool v6;
+	int ret;
+
+	tuple = (const struct flow_offload_tuple *)cls->cookie;
+	if (!tuple || tuple->dir > FLOW_OFFLOAD_DIR_REPLY)
+		return -EINVAL;
+	if (tuple->l3proto == NFPROTO_IPV6)
+		v6 = true;
+	else if (tuple->l3proto == NFPROTO_IPV4)
+		v6 = false;
+	else
+		return -EOPNOTSUPP;
+	if (tuple->l4proto != IPPROTO_TCP && tuple->l4proto != IPPROTO_UDP)
+		return -EOPNOTSUPP;
+	if (!tuple->mtu)
+		return -EOPNOTSUPP;
+
+	th = container_of(tuple, struct flow_offload_tuple_rhash, tuple);
+	if (tuple->dir == FLOW_OFFLOAD_DIR_ORIGINAL)
+		flow = container_of(th, struct flow_offload,
+				    tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL]);
+	else
+		flow = container_of(th, struct flow_offload,
+				    tuplehash[FLOW_OFFLOAD_DIR_REPLY]);
+	other = &flow->tuplehash[!tuple->dir].tuple;
+
+	if (cvm_encap_from_tuple(tuple, &in_encap) ||
+	    cvm_encap_from_tuple(other, &out_encap)) {
+		atomic64_inc(&flow_shortcut_rejected);
+		net_info_ratelimited("octeon flow shortcut: encap %u/%u proto %04x+%04x / %04x+%04x\n",
+				     (unsigned int)tuple->encap_num,
+				     (unsigned int)other->encap_num,
+				     cvm_tuple_encap_proto(tuple, 0),
+				     cvm_tuple_encap_proto(tuple, 1),
+				     cvm_tuple_encap_proto(other, 0),
+				     cvm_tuple_encap_proto(other, 1));
+		return -EOPNOTSUPP;
+	}
+
+	/*
+	 * The neighbour lookup below reads an IPv4 route. Hardware offload
+	 * installs DIRECT, with the ethernet header already filled in, and
+	 * that is the path used for both families. An IPv6 neighbour tuple
+	 * stays on the normal path.
+	 */
+	if (v6 && tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT) {
+		atomic64_inc(&flow_shortcut_rejected);
+		net_info_ratelimited("octeon flow shortcut: ipv6 xmit %u %pI6c:%u -> %pI6c:%u\n",
+				     tuple->xmit_type,
+				     &tuple->src_v6, ntohs(tuple->src_port),
+				     &tuple->dst_v6, ntohs(tuple->dst_port));
+		return -EOPNOTSUPP;
+	}
+
+	ret = cvm_flow_l2(block->net, flow, tuple, out_encap.pppoe,
+			  h_source, h_dest, &txdev);
+	if (ret) {
+		atomic64_inc(&flow_shortcut_rejected);
+		if (v6)
+			net_info_ratelimited("octeon flow shortcut: skip %pI6c:%u -> %pI6c:%u (%d)\n",
+					     &tuple->src_v6, ntohs(tuple->src_port),
+					     &tuple->dst_v6, ntohs(tuple->dst_port),
+					     ret);
+		else
+			net_info_ratelimited("octeon flow shortcut: skip %pI4:%u -> %pI4:%u (%d)\n",
+					     &tuple->src_v4, ntohs(tuple->src_port),
+					     &tuple->dst_v4, ntohs(tuple->dst_port),
+					     ret);
+		return ret;
+	}
+
+	/* The reverse egress source MAC is this direction's local RX MAC. */
+	ret = cvm_flow_l2(block->net, flow, other, in_encap.pppoe,
+			  in_h_dest, in_h_source, &rxdev);
+	if (!ret) {
+		if (!cvm_flow_port_bound(block, rxdev))
+			ret = -EOPNOTSUPP;
+		dev_put(rxdev);
+	}
+	if (ret) {
+		atomic64_inc(&flow_shortcut_rejected);
+		dev_put(txdev);
+		return ret;
+	}
+
+	if (out_encap.pppoe || out_encap.vlan) {
+		if (is_zero_ether_addr(h_dest)) {
+			dev_put(txdev);
+			atomic64_inc(&flow_shortcut_rejected);
+			return -ENOENT;
+		}
+	}
+	e = kzalloc(sizeof(*e), GFP_ATOMIC);
+	if (!e) {
+		dev_put(txdev);
+		return -ENOMEM;
+	}
+
+	e->cookie = cls->cookie;
+	e->block = block;
+	e->v6 = v6;
+	e->sport = tuple->src_port;
+	e->dport = tuple->dst_port;
+	e->proto = tuple->l4proto;
+	e->iifidx = tuple->iifidx;
+	e->nsport = e->sport;
+	e->ndport = e->dport;
+	e->mtu = tuple->mtu;
+	e->txdev = txdev;
+	e->in_pppoe = in_encap.pppoe;
+	e->out_pppoe = out_encap.pppoe;
+	e->in_vlan = in_encap.vlan;
+	e->out_vlan = out_encap.vlan;
+	e->in_sid = in_encap.sid;
+	e->out_sid = out_encap.sid;
+	e->in_vid = in_encap.vid;
+	e->out_vid = out_encap.vid;
+	ether_addr_copy(e->h_source, h_source);
+	ether_addr_copy(e->h_dest, h_dest);
+	ether_addr_copy(e->in_h_dest, in_h_dest);
+
+	/*
+	 * Same rewrite the software flowtable applies. Masquerade is SNAT:
+	 * the original direction changes the source, the reply changes the
+	 * destination back. IPv6 on a routed prefix usually has neither
+	 * flag set, so only the hop limit changes. The addresses still
+	 * follow the flags when NAT is in use.
+	 */
+	if (v6) {
+		e->s6 = tuple->src_v6;
+		e->d6 = tuple->dst_v6;
+		e->ns6 = e->s6;
+		e->nd6 = e->d6;
+		if (test_bit(NF_FLOW_SNAT, &flow->flags)) {
+			if (tuple->dir == FLOW_OFFLOAD_DIR_ORIGINAL) {
+				e->ns6 = other->dst_v6;
+				e->nsport = other->dst_port;
+			} else {
+				e->nd6 = other->src_v6;
+				e->ndport = other->src_port;
+			}
+		}
+		if (test_bit(NF_FLOW_DNAT, &flow->flags)) {
+			if (tuple->dir == FLOW_OFFLOAD_DIR_ORIGINAL) {
+				e->nd6 = other->src_v6;
+				e->ndport = other->src_port;
+			} else {
+				e->ns6 = other->dst_v6;
+				e->nsport = other->dst_port;
+			}
+		}
+	} else {
+		e->saddr = tuple->src_v4.s_addr;
+		e->daddr = tuple->dst_v4.s_addr;
+		e->nsaddr = e->saddr;
+		e->ndaddr = e->daddr;
+		if (test_bit(NF_FLOW_SNAT, &flow->flags)) {
+			if (tuple->dir == FLOW_OFFLOAD_DIR_ORIGINAL) {
+				e->nsaddr = other->dst_v4.s_addr;
+				e->nsport = other->dst_port;
+			} else {
+				e->ndaddr = other->src_v4.s_addr;
+				e->ndport = other->src_port;
+			}
+		}
+		if (test_bit(NF_FLOW_DNAT, &flow->flags)) {
+			if (tuple->dir == FLOW_OFFLOAD_DIR_ORIGINAL) {
+				e->ndaddr = other->src_v4.s_addr;
+				e->ndport = other->src_port;
+			} else {
+				e->nsaddr = other->dst_v4.s_addr;
+				e->nsport = other->dst_port;
+			}
+		}
+	}
+
+	spin_lock_bh(&cvm_flow_lock);
+	if (cvm_flow_by_cookie(block, cls->cookie)) {
+		spin_unlock_bh(&cvm_flow_lock);
+		dev_put(txdev);
+		kfree(e);
+		return 0;
+	}
+	if (e->v6)
+		hash = cvm_flow_hash6(&e->s6, &e->d6, e->sport, e->dport,
+				      e->proto, e->iifidx);
+	else
+		hash = cvm_flow_hash(e->saddr, e->daddr, e->sport, e->dport,
+				     e->proto, e->iifidx);
+	hlist_add_head_rcu(&e->node,
+			   &cvm_flow_buckets[hash & (CVM_FLOW_BUCKETS - 1)]);
+	hash = hash_ptr((void *)e->cookie, 10);
+	hlist_add_head(&e->cookie_node,
+		       &cvm_flow_cookies[hash & (CVM_FLOW_BUCKETS - 1)]);
+	list_add_tail(&e->owner_node, &block->flows);
+	atomic64_inc(&flow_shortcut_installed);
+	spin_unlock_bh(&cvm_flow_lock);
+	return 0;
+}
+
+static int cvm_flow_destroy(struct cvm_flow_block *block,
+			    struct flow_cls_offload *cls)
+{
+	struct cvm_flow *e;
+
+	spin_lock_bh(&cvm_flow_lock);
+	e = cvm_flow_by_cookie(block, cls->cookie);
+	if (e)
+		cvm_flow_delete(e);
+	spin_unlock_bh(&cvm_flow_lock);
+	return 0;
+}
+
+static int cvm_flow_stats(struct cvm_flow_block *block,
+			  struct flow_cls_offload *cls)
+{
+	struct cvm_flow *e;
+	u64 pkts, bytes, reported_pkts, reported_bytes;
+
+	rcu_read_lock();
+	spin_lock_bh(&cvm_flow_lock);
+	e = cvm_flow_by_cookie(block, cls->cookie);
+	if (e) {
+		pkts = atomic64_read(&e->pkts);
+		bytes = atomic64_read(&e->bytes);
+		reported_pkts = atomic64_read(&e->pkts_reported);
+		reported_bytes = atomic64_read(&e->bytes_reported);
+		if (pkts != reported_pkts) {
+			cls->stats.pkts = pkts - reported_pkts;
+			cls->stats.bytes = bytes - reported_bytes;
+			cls->stats.lastused = READ_ONCE(e->lastused);
+			atomic64_set(&e->pkts_reported, pkts);
+			atomic64_set(&e->bytes_reported, bytes);
+		}
+	}
+	spin_unlock_bh(&cvm_flow_lock);
+	rcu_read_unlock();
+	return 0;
+}
+
+static int cvm_oct_flow_offload(struct cvm_flow_block *block,
+				struct flow_cls_offload *cls)
+{
+	switch (cls->command) {
+	case FLOW_CLS_REPLACE:
+		return cvm_flow_replace(block, cls);
+	case FLOW_CLS_DESTROY:
+		return cvm_flow_destroy(block, cls);
+	case FLOW_CLS_STATS:
+		return cvm_flow_stats(block, cls);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int cvm_oct_setup_tc_block_cb(enum tc_setup_type type, void *type_data,
+				     void *cb_priv)
+{
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+	return cvm_oct_flow_offload(cb_priv, type_data);
+}
+
+static void cvm_flow_block_release(void *cb_priv)
+{
+	kfree(cb_priv);
+}
+
+/*
+ * The ER-12 binds its flowtable to "itf", a Linux bond. The bond has no
+ * ndo_setup_tc, so nf_flow_table_offload_setup() takes the indirect path:
+ * flow_indr_dev_setup_offload() calls every registered indirect driver
+ * callback. This function is that callback.
+ *
+ * The callback contract is:
+ *   cb(dev, sch, cb_priv, type, type_data, data, cleanup)
+ * where type_data is the flow_block_offload, data is the flowtable and
+ * cleanup is the core's teardown callback for an indirect block.
+ */
+static int cvm_oct_flow_indr_bind(struct net_device *dev, struct Qdisc *sch,
+				   void *cb_priv, enum tc_setup_type type,
+				   void *type_data, void *data,
+				   void (*cleanup)(struct flow_block_cb *block_cb))
+{
+	struct flow_block_offload *f = type_data;
+	struct cvm_flow_block *block;
+	struct cvm_flow_port *port;
+	struct flow_block_cb *block_cb;
+	int ret = 0;
+
+	if (type != TC_SETUP_FT)
+		return -EOPNOTSUPP;
+	if (!f)
+		return -EINVAL;
+	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+	if (!cvm_oct_flow_chip_ok())
+		return -EOPNOTSUPP;
+
+	/*
+	 * Only a device that can reach an Octeon port is useful. The
+	 * ER-12 flowtable device is the itf bond; a plain Octeon port is
+	 * accepted too, so a hand-written flowtable can bind to lan4.
+	 */
+	if (!netif_is_bond_master(dev) && !cvm_flow_octeon_dev(dev))
+		return -EOPNOTSUPP;
+
+	/*
+	 * Share one callback among this flowtable's ports. A separate table
+	 * (including fw4's nft -c probe) gets its own callback and flow list.
+	 * The core holds this flowtable's flow_block_lock for writing here,
+	 * excluding its replace/destroy/stats callbacks. The mutex protects
+	 * the driver list and global binding count across different tables.
+	 */
+	mutex_lock(&cvm_oct_block_cb_mutex);
+	block_cb = flow_block_cb_lookup(f->block, cvm_oct_setup_tc_block_cb,
+				       &cvm_oct_block_cb_list);
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		if (block_cb &&
+		    cvm_flow_port_find(flow_block_cb_priv(block_cb), dev))
+			break;
+		port = kzalloc(sizeof(*port), GFP_KERNEL);
+		if (!port) {
+			ret = -ENOMEM;
+			break;
+		}
+		if (!block_cb) {
+			block = kzalloc(sizeof(*block), GFP_KERNEL);
+			if (!block) {
+				kfree(port);
+				ret = -ENOMEM;
+				break;
+			}
+			block->net = dev_net(dev);
+			INIT_LIST_HEAD(&block->ports);
+			INIT_LIST_HEAD(&block->flows);
+			block_cb = flow_indr_block_cb_alloc(
+					cvm_oct_setup_tc_block_cb,
+					&cvm_oct_block_cb_list, block,
+					cvm_flow_block_release, f, dev, sch,
+					data, NULL, cleanup);
+			if (IS_ERR(block_cb)) {
+				ret = PTR_ERR(block_cb);
+				kfree(block);
+				kfree(port);
+				break;
+			}
+			flow_block_cb_add(block_cb, f);
+			list_add_tail(&block_cb->driver_list,
+				      &cvm_oct_block_cb_list);
+		}
+		block = flow_block_cb_priv(block_cb);
+		port->dev = dev;
+		list_add_tail(&port->node, &block->ports);
+		cvm_oct_flow_binds++;
+		WRITE_ONCE(cvm_oct_flow_shortcut, 1);
+		break;
+	case FLOW_BLOCK_UNBIND:
+		if (!block_cb) {
+			ret = -ENOENT;
+			break;
+		}
+		block = flow_block_cb_priv(block_cb);
+		port = cvm_flow_port_find(block, dev);
+		if (!port) {
+			ret = -ENOENT;
+			break;
+		}
+		list_del(&port->node);
+		kfree(port);
+		/*
+		 * nftables unbinds before destroying the flowtable, so its
+		 * later FLOW_CLS_DESTROY calls may have no callback left.
+		 * Flush this table now, also covering partial port removal.
+		 * Remaining ports can reinstall eligible flows via software.
+		 */
+		cvm_flow_flush(block);
+		if (list_empty(&block->ports)) {
+			flow_indr_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+		}
+		cvm_oct_flow_binds--;
+		WRITE_ONCE(cvm_oct_flow_shortcut, cvm_oct_flow_binds > 0);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		break;
+	}
+	mutex_unlock(&cvm_oct_block_cb_mutex);
+	return ret;
+}
+
+/*
+ * Register and unregister the indirect offload provider. The core calls
+ * the bind callback for every device in an offload-enabled flowtable, so
+ * this is what makes the ER-12's "itf" bond eligible.
+ */
+int cvm_oct_flow_indr_register(void)
+{
+	return flow_indr_dev_register(cvm_oct_flow_indr_bind, NULL);
+}
+
+void cvm_oct_flow_indr_unregister(void)
+{
+	flow_indr_dev_unregister(cvm_oct_flow_indr_bind, NULL,
+				 cvm_flow_block_release);
+}
+
+static void cvm_flow_fixup(struct sk_buff *skb, struct iphdr *iph,
+			   struct cvm_flow *e)
+{
+	__sum16 *l4sum = NULL;
+	bool l4 = false;
+
+	if (iph->protocol == IPPROTO_TCP) {
+		l4sum = &((struct tcphdr *)(iph + 1))->check;
+		l4 = true;
+	} else {
+		struct udphdr *uh = (struct udphdr *)(iph + 1);
+
+		if (uh->check) {
+			l4sum = &uh->check;
+			l4 = true;
+		}
+	}
+
+	if (e->nsaddr != iph->saddr) {
+		csum_replace4(&iph->check, iph->saddr, e->nsaddr);
+		if (l4)
+			csum_replace4(l4sum, iph->saddr, e->nsaddr);
+		iph->saddr = e->nsaddr;
+	}
+	if (e->ndaddr != iph->daddr) {
+		csum_replace4(&iph->check, iph->daddr, e->ndaddr);
+		if (l4)
+			csum_replace4(l4sum, iph->daddr, e->ndaddr);
+		iph->daddr = e->ndaddr;
+	}
+	if (iph->protocol == IPPROTO_TCP) {
+		struct tcphdr *th = (struct tcphdr *)(iph + 1);
+
+		if (e->nsport != th->source) {
+			csum_replace2(&th->check, th->source, e->nsport);
+			th->source = e->nsport;
+		}
+		if (e->ndport != th->dest) {
+			csum_replace2(&th->check, th->dest, e->ndport);
+			th->dest = e->ndport;
+		}
+	} else if (l4) {
+		struct udphdr *uh = (struct udphdr *)(iph + 1);
+
+		if (e->nsport != uh->source) {
+			csum_replace2(&uh->check, uh->source, e->nsport);
+			uh->source = e->nsport;
+		}
+		if (e->ndport != uh->dest) {
+			csum_replace2(&uh->check, uh->dest, e->ndport);
+			uh->dest = e->ndport;
+		}
+		if (!uh->check)
+			uh->check = CSUM_MANGLED_0;
+	} else {
+		struct udphdr *uh = (struct udphdr *)(iph + 1);
+
+		uh->source = e->nsport;
+		uh->dest = e->ndport;
+	}
+
+	ip_decrease_ttl(iph);
+}
+
+/*
+ * IPv6 has no header checksum. A hop-limit change does not affect the
+ * transport checksum. An address change does, and a zero UDP checksum is
+ * illegal, so the receive path rejects that before calling this.
+ */
+static void cvm_flow_fixup6(struct sk_buff *skb, struct ipv6hdr *ip6h,
+			    struct cvm_flow *e)
+{
+	struct tcphdr *th;
+	struct udphdr *uh;
+	__sum16 *l4sum;
+
+	if (ip6h->nexthdr == IPPROTO_TCP) {
+		th = (struct tcphdr *)(ip6h + 1);
+		l4sum = &th->check;
+	} else {
+		uh = (struct udphdr *)(ip6h + 1);
+		l4sum = &uh->check;
+	}
+
+	if (!cvm_flow_addr6_eq(&e->ns6, &ip6h->saddr)) {
+		inet_proto_csum_replace16(l4sum, skb, ip6h->saddr.s6_addr32,
+					  e->ns6.s6_addr32, true);
+		ip6h->saddr = e->ns6;
+	}
+	if (!cvm_flow_addr6_eq(&e->nd6, &ip6h->daddr)) {
+		inet_proto_csum_replace16(l4sum, skb, ip6h->daddr.s6_addr32,
+					  e->nd6.s6_addr32, true);
+		ip6h->daddr = e->nd6;
+	}
+	if (ip6h->nexthdr == IPPROTO_TCP) {
+		th = (struct tcphdr *)(ip6h + 1);
+
+		if (e->nsport != th->source) {
+			csum_replace2(&th->check, th->source, e->nsport);
+			th->source = e->nsport;
+		}
+		if (e->ndport != th->dest) {
+			csum_replace2(&th->check, th->dest, e->ndport);
+			th->dest = e->ndport;
+		}
+	} else {
+		uh = (struct udphdr *)(ip6h + 1);
+
+		if (e->nsport != uh->source) {
+			csum_replace2(&uh->check, uh->source, e->nsport);
+			uh->source = e->nsport;
+		}
+		if (e->ndport != uh->dest) {
+			csum_replace2(&uh->check, uh->dest, e->ndport);
+			uh->dest = e->ndport;
+		}
+		/* A zero checksum is illegal in IPv6. */
+		if (!uh->check)
+			uh->check = CSUM_MANGLED_0;
+	}
+
+	ip6h->hop_limit--;
+}
+
+/* Slide the ethernet header over a session header that already matched. */
+static void cvm_flow_pop_pppoe(struct sk_buff *skb, __be16 proto)
+{
+	struct ethhdr *eth;
+
+	memmove(skb->data + PPPOE_SES_HLEN, skb->data, ETH_HLEN);
+	skb_pull(skb, PPPOE_SES_HLEN);
+	eth = (struct ethhdr *)skb->data;
+	eth->h_proto = proto;
+}
+
+/*
+ * Insert the 8-byte session header between ethernet and IP.
+ * The caller has already checked headroom. Length is the PPP payload.
+ */
+static void cvm_flow_push_pppoe(struct sk_buff *skb, __be16 sid)
+{
+	struct ethhdr *eth;
+	struct pppoe_hdr *ph;
+	unsigned int payload;
+	__be16 ppp_proto;
+
+	eth = (struct ethhdr *)skb->data;
+	if (eth->h_proto == htons(ETH_P_IPV6)) {
+		payload = ntohs(((struct ipv6hdr *)(eth + 1))->payload_len) +
+			  sizeof(struct ipv6hdr);
+		ppp_proto = htons(PPP_IPV6);
+	} else {
+		payload = ntohs(((struct iphdr *)(eth + 1))->tot_len);
+		ppp_proto = htons(PPP_IP);
+	}
+	skb_push(skb, PPPOE_SES_HLEN);
+	memmove(skb->data, skb->data + PPPOE_SES_HLEN, ETH_HLEN);
+	eth = (struct ethhdr *)skb->data;
+	eth->h_proto = htons(ETH_P_PPP_SES);
+	ph = (struct pppoe_hdr *)(eth + 1);
+	*(u8 *)ph = 0x11;
+	ph->code = 0;
+	ph->sid = sid;
+	ph->length = htons(payload + 2);
+	*(__be16 *)((u8 *)ph + sizeof(*ph)) = ppp_proto;
+}
+
+/*
+ * Drop a tag that already matched. The inner ethertype slides into place.
+ *
+ * Keep skb->data at the MAC header after removing the tag. cvm_oct_xmit()
+ * calls __skb_vlan_pop(), which refuses to run when skb->data is not at
+ * the MAC header.
+ */
+static void cvm_flow_pop_vlan(struct sk_buff *skb)
+{
+	memmove(skb->data + VLAN_HLEN, skb->data, 2 * ETH_ALEN);
+	skb_pull(skb, VLAN_HLEN);
+	skb_reset_mac_header(skb);
+}
+
+/*
+ * Insert one 802.1Q tag between the ethernet header and whatever follows.
+ * The caller has already checked headroom. vid is the tag control word
+ * with priority left at zero.
+ */
+static void cvm_flow_push_vlan(struct sk_buff *skb, __be16 vid)
+{
+	struct ethhdr *eth;
+	struct vlan_hdr *vh;
+	__be16 proto;
+
+	eth = (struct ethhdr *)skb->data;
+	proto = eth->h_proto;
+	skb_push(skb, VLAN_HLEN);
+	if (skb_mac_header_was_set(skb))
+		skb->mac_header -= VLAN_HLEN;
+	memmove(skb->data, skb->data + VLAN_HLEN, 2 * ETH_ALEN);
+	eth = (struct ethhdr *)skb->data;
+	eth->h_proto = htons(ETH_P_8021Q);
+	vh = (struct vlan_hdr *)(eth + 1);
+	vh->h_vlan_TCI = vid;
+	vh->h_vlan_encapsulated_proto = proto;
+}
+
+bool cvm_oct_flow_receive(struct net_device *dev, struct sk_buff *skb,
+			  const struct cvmx_wqe *work)
+{
+	struct net_device *master, *txdev;
+	struct pppoe_hdr *ph;
+	struct ethhdr *eth;
+	struct iphdr *iph = NULL;
+	struct ipv6hdr *ip6h = NULL;
+	struct cvm_flow *e;
+	unsigned int l2, pppoe_len = 0, push_len, pkt_len = 0;
+	__be16 sid = 0, vid = 0, inner, sport = 0, dport = 0;
+	int iifidx;
+	u8 proto = 0;
+	u8 saw_pppoe = 0, saw_vlan = 0, is_v6 = 0;
+	u8 push_pppoe, push_vlan;
+	__be16 push_sid, push_vid;
+
+	if (!cvm_oct_flow_chip_ok())
+		return false;
+
+	/*
+	 * These bits mean the same thing whether or not the parser found
+	 * an IP header. Two VLAN tags stay on the normal path. One tag is
+	 * parsed below; the CN50xx reports it with vlan_valid and an IP
+	 * offset of 18 when the payload is IPv4 or IPv6. PPPoE is not IP
+	 * to that parser, so the family is read from the PPP protocol.
+	 */
+	if (unlikely(work->word2.snoip.rcv_error ||
+		     work->word2.snoip.is_mcast ||
+		     work->word2.snoip.is_bcast ||
+		     work->word2.snoip.vlan_stacked))
+		return false;
+	if (unlikely(skb->len < ETH_HLEN + sizeof(struct iphdr)))
+		return false;
+
+	/* cvm_oct_xmit() and the VLAN helpers require skb->data at the MAC header. */
+	skb_reset_mac_header(skb);
+
+	eth = (struct ethhdr *)skb->data;
+	inner = eth->h_proto;
+	l2 = ETH_HLEN;
+	/*
+	 * ER-12: the QCA8511 CPU port delivers untagged frames and the
+	 * driver adds the in-band VID 4094 switch0 tag in software before
+	 * this point. The hardware never saw a VLAN, so the tag has to be
+	 * read from the frame itself rather than from the WQE.
+	 */
+	if (eth->h_proto == htons(ETH_P_8021Q)) {
+		struct vlan_hdr *vh;
+		unsigned int tag_vid;
+
+		if (skb->len < ETH_HLEN + VLAN_HLEN + sizeof(*iph))
+			return false;
+		vh = (struct vlan_hdr *)(eth + 1);
+		tag_vid = ntohs(vh->h_vlan_TCI) & VLAN_VID_MASK;
+		if (tag_vid != cvm_oct_get_vlan_switch0_vid())
+			return false;
+		vid = htons(tag_vid);
+		inner = vh->h_vlan_encapsulated_proto;
+		l2 = ETH_HLEN + VLAN_HLEN;
+		saw_vlan = 1;
+	}
+
+	if (inner == htons(ETH_P_IP) || inner == htons(ETH_P_IPV6)) {
+		/*
+		 * Plain IP and VLAN plus IP still require the hardware
+		 * parse. PPPoE is not IP to that parser, so those bits are
+		 * not valid there. ip_offset is 14, or 18 behind one tag.
+		 */
+		if (unlikely(work->word2.s.not_IP ||
+			     work->word2.s.is_frag || work->word2.s.IP_exc ||
+			     work->word2.s.L4_error ||
+			     (work->word2.s.ip_offset != l2 &&
+			      work->word2.s.ip_offset != ETH_HLEN) ||
+			     !work->word2.s.tcp_or_udp))
+			return false;
+		if (inner == htons(ETH_P_IPV6)) {
+			if (unlikely(!work->word2.s.is_v6))
+				return false;
+			is_v6 = 1;
+		} else if (unlikely(work->word2.s.is_v6)) {
+			return false;
+		}
+	} else if (inner == htons(ETH_P_PPP_SES)) {
+		__be16 ppp_proto;
+
+		if (skb->len < l2 + PPPOE_SES_HLEN + sizeof(struct iphdr))
+			return false;
+		ph = (struct pppoe_hdr *)(skb->data + l2);
+		/* Version 1, type 1. Discovery uses a different ethertype. */
+		if (*(u8 *)ph != 0x11 || ph->code != 0)
+			return false;
+		ppp_proto = *(__be16 *)((u8 *)ph + sizeof(*ph));
+		if (ppp_proto == htons(PPP_IPV6))
+			is_v6 = 1;
+		else if (ppp_proto != htons(PPP_IP))
+			return false;
+		l2 += PPPOE_SES_HLEN;
+		saw_pppoe = 1;
+		sid = ph->sid;
+		pppoe_len = ntohs(ph->length);
+	} else {
+		return false;
+	}
+
+	if (is_v6) {
+		unsigned int l4len;
+
+		if (skb->len < l2 + sizeof(*ip6h))
+			return false;
+		ip6h = (struct ipv6hdr *)(skb->data + l2);
+		/* High nibble, so this does not depend on bitfield order. */
+		if ((*(u8 *)ip6h >> 4) != 6)
+			return false;
+		/*
+		 * Extension headers, fragments, and neighbor discovery use
+		 * a next-header value other than TCP or UDP. A multicast
+		 * destination stays on the normal path as well.
+		 */
+		if (ip6h->nexthdr != IPPROTO_TCP &&
+		    ip6h->nexthdr != IPPROTO_UDP)
+			return false;
+		if (ip6h->hop_limit <= 1)
+			return false;
+		if (ip6h->daddr.s6_addr[0] == 0xff)
+			return false;
+		l4len = ip6h->nexthdr == IPPROTO_TCP ? sizeof(struct tcphdr)
+						     : sizeof(struct udphdr);
+		if (ntohs(ip6h->payload_len) < l4len)
+			return false;
+		pkt_len = ntohs(ip6h->payload_len) + sizeof(*ip6h);
+		if (l2 + pkt_len > skb->len)
+			return false;
+		if (saw_pppoe && pppoe_len < pkt_len + 2)
+			return false;
+		proto = ip6h->nexthdr;
+		if (proto == IPPROTO_TCP) {
+			struct tcphdr *th = (struct tcphdr *)(ip6h + 1);
+
+			if (th->fin || th->rst)
+				return false;
+			sport = th->source;
+			dport = th->dest;
+		} else {
+			struct udphdr *uh = (struct udphdr *)(ip6h + 1);
+
+			if (!uh->check)
+				return false;
+			sport = uh->source;
+			dport = uh->dest;
+		}
+	} else {
+		iph = (struct iphdr *)(skb->data + l2);
+		if (iph->version != 4 || iph->ihl != 5)
+			return false;
+		if (iph->ttl <= 1)
+			return false;
+		if (unlikely(ntohs(iph->tot_len) < sizeof(*iph) +
+			     sizeof(struct udphdr)))
+			return false;
+		pkt_len = ntohs(iph->tot_len);
+		if (l2 + pkt_len > skb->len)
+			return false;
+		if (saw_pppoe && pppoe_len < pkt_len + 2)
+			return false;
+		proto = iph->protocol;
+		if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+			return false;
+		if (proto == IPPROTO_TCP &&
+		    pkt_len < sizeof(*iph) + sizeof(struct tcphdr))
+			return false;
+		if (ip_is_fragment(iph))
+			return false;
+		if (proto == IPPROTO_TCP) {
+			struct tcphdr *th = (struct tcphdr *)(iph + 1);
+
+			if (th->fin || th->rst)
+				return false;
+			sport = th->source;
+			dport = th->dest;
+		} else {
+			struct udphdr *uh = (struct udphdr *)(iph + 1);
+
+			sport = uh->source;
+			dport = uh->dest;
+		}
+	}
+
+	rcu_read_lock();
+	/*
+	 * The flow key is the interface nftables recorded for the flow,
+	 * which is the device the flowtable is hooked on. fw4 hooks the
+	 * "itf" bond, so the key is the bond's index. This hook runs on
+	 * the Octeon port that received the frame, and the port's master
+	 * is that bond, so the port index and the bond index are the two
+	 * candidates. Upstream used the port index and then the bridge
+	 * master, which is the same idea for the USG.
+	 */
+	iifidx = dev->ifindex;
+	master = netdev_master_upper_dev_get_rcu(dev);
+	if (is_v6) {
+		e = cvm_flow_lookup6(&ip6h->saddr, &ip6h->daddr, sport, dport,
+				     proto, iifidx);
+		if (!e && master)
+			e = cvm_flow_lookup6(&ip6h->saddr, &ip6h->daddr, sport,
+					     dport, proto, master->ifindex);
+	} else {
+		e = cvm_flow_lookup(iph->saddr, iph->daddr, sport, dport,
+				    proto, iifidx);
+		if (!e && master)
+			e = cvm_flow_lookup(iph->saddr, iph->daddr, sport,
+					    dport, proto, master->ifindex);
+	}
+	if (!e || e->v6 != is_v6) {
+		rcu_read_unlock();
+		atomic64_inc(&flow_shortcut_miss);
+		return false;
+	}
+	push_len = (e->out_vlan ? VLAN_HLEN : 0) +
+		   (e->out_pppoe ? PPPOE_SES_HLEN : 0);
+	if (!ether_addr_equal(eth->h_dest, e->in_h_dest) ||
+	    (saw_vlan && (!e->in_vlan || e->in_vid != vid)) ||
+	    (!saw_vlan && e->in_vlan) ||
+	    (saw_pppoe && (!e->in_pppoe || e->in_sid != sid)) ||
+	    (!saw_pppoe && e->in_pppoe) ||
+	    skb_headroom(skb) < push_len ||
+	    pkt_len > e->mtu ||
+	    !(e->txdev->flags & IFF_UP) || !netif_carrier_ok(e->txdev) ||
+	    netif_xmit_stopped(netdev_get_tx_queue(e->txdev, 0))) {
+		rcu_read_unlock();
+		atomic64_inc(&flow_shortcut_miss);
+		return false;
+	}
+
+	/*
+	 * Pop outer header first, while the buffer is still the frame we
+	 * received. Push happens after the RCU section, into headroom that
+	 * was checked above, so a miss still returns the original buffer.
+	 * PPPoE is pushed before the VLAN tag so the tag stays outside.
+	 */
+	if (saw_vlan)
+		cvm_flow_pop_vlan(skb);
+	if (saw_pppoe)
+		cvm_flow_pop_pppoe(skb, is_v6 ? htons(ETH_P_IPV6) :
+					       htons(ETH_P_IP));
+	eth = (struct ethhdr *)skb->data;
+	ether_addr_copy(eth->h_dest, e->h_dest);
+	ether_addr_copy(eth->h_source, e->h_source);
+	if (is_v6) {
+		ip6h = (struct ipv6hdr *)(eth + 1);
+		cvm_flow_fixup6(skb, ip6h, e);
+	} else {
+		iph = (struct iphdr *)(eth + 1);
+		cvm_flow_fixup(skb, iph, e);
+	}
+	atomic64_inc(&e->pkts);
+	atomic64_add(pkt_len, &e->bytes);
+	WRITE_ONCE(e->lastused, nf_flowtable_time_stamp);
+	atomic64_inc(&flow_shortcut_hit);
+
+	/*
+	 * cvm_oct_xmit takes the skb and frees other skbs, so it must not
+	 * run inside this RCU section. Hold the device across that. The
+	 * send does not use the async scratch path on this build (CVMSEG
+	 * size is 0). Leave protocol clear: the PKO checksum offload keys
+	 * off ETH_P_IP plus skb_network_offset(), which this path does not
+	 * set. Header checksums were adjusted above.
+	 */
+	txdev = e->txdev;
+	push_sid = e->out_sid;
+	push_pppoe = e->out_pppoe;
+	push_vid = e->out_vid;
+	push_vlan = e->out_vlan;
+	dev_hold(txdev);
+	rcu_read_unlock();
+
+	if (push_pppoe)
+		cvm_flow_push_pppoe(skb, push_sid);
+	if (push_vlan)
+		cvm_flow_push_vlan(skb, push_vid);
+	skb->protocol = 0;
+	skb->dev = txdev;
+	cvm_oct_xmit(skb, txdev);
+	dev_put(txdev);
+	return true;
+}
