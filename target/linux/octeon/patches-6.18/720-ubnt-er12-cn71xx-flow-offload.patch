+int cvm_oct_flow_shortcut;
+module_param_named(flow_shortcut, cvm_oct_flow_shortcut, int, 0644);
+MODULE_PARM_DESC(flow_shortcut,
+		 "Rewrite established flows. Set while a hardware flowtable is bound");
+
+/*
+ * One callback per flowtable, shared by its bound ports. The receive path
+ * stays on while any port is bound.
+ */
+static int cvm_oct_flow_binds;
+static DEFINE_MUTEX(cvm_oct_block_cb_mutex);
+module_param_named(flow_binds, cvm_oct_flow_binds, int, 0444);
+MODULE_PARM_DESC(flow_binds, "Ingress flowtable bindings still held");
+
+/*
+ * The receive path runs on every CPU, so the counters are atomic. They
+ * are exported read-only: the values are evidence, not a control. A
+ * custom get keeps the sysfs format a plain decimal number, so the
+ * existing scripts and the runbook keep working.
+ */
+static atomic64_t flow_shortcut_hit;
+static atomic64_t flow_shortcut_miss;
+static atomic64_t flow_shortcut_installed;
+static atomic64_t flow_shortcut_rejected;
+
+static int cvm_flow_counter_set(const char *val, const struct kernel_param *kp)
+{
+	return -EPERM;
+}
+static int cvm_flow_counter_get(char *buffer, const struct kernel_param *kp)
+{
+	return sysfs_emit(buffer, "%lld\n",
+			  (long long)atomic64_read((atomic64_t *)kp->arg));
+}
+
+static const struct kernel_param_ops cvm_flow_counter_ops = {
+	.set = cvm_flow_counter_set,
+	.get = cvm_flow_counter_get,
+};
+module_param_cb(flow_shortcut_hit, &cvm_flow_counter_ops,
+		&flow_shortcut_hit, 0444);
+module_param_cb(flow_shortcut_miss, &cvm_flow_counter_ops,
+		&flow_shortcut_miss, 0444);
+module_param_cb(flow_shortcut_installed, &cvm_flow_counter_ops,
+		&flow_shortcut_installed, 0444);
+module_param_cb(flow_shortcut_rejected, &cvm_flow_counter_ops,
+		&flow_shortcut_rejected, 0444);
+MODULE_PARM_DESC(flow_shortcut_hit, "Packets rewritten by the fast path");
+MODULE_PARM_DESC(flow_shortcut_miss, "Flow lookups that did not match");
+MODULE_PARM_DESC(flow_shortcut_installed, "Flows handed to the driver");
+MODULE_PARM_DESC(flow_shortcut_rejected, "Flows the driver refused");
+
+/*
+ * The model check reads the coprocessor id, so the answer is cached.
+ * PKND marks the CN68xx word2. The receive path calls this on every
+ * packet while the shortcut is on.
+ */
+static bool cvm_oct_flow_board_ok(void)
+{
+	static int ok = -1;
+
+	if (READ_ONCE(ok) < 0)
+		WRITE_ONCE(ok, of_machine_is_compatible("ubnt,edgerouter-12"));
+	return READ_ONCE(ok);
+}
+
+static bool cvm_oct_flow_chip_ok(void)
+{
+	static int ok = -1;
+
+	if (READ_ONCE(ok) < 0)
+		WRITE_ONCE(ok, (OCTEON_IS_MODEL(OCTEON_CN50XX) ||
+				   (OCTEON_IS_MODEL(OCTEON_CN71XX) &&
+				    cvm_oct_flow_board_ok())) &&
+				   !octeon_has_feature(OCTEON_FEATURE_PKND));
+	return READ_ONCE(ok);
+}
